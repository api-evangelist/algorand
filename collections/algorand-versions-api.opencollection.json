{
  "opencollection": "1.0.0",
  "info": {
    "name": "Algod REST API. common Versions API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Algo-API-Token",
      "value": "{{X-Algo-API-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Versions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieves the current version",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost/versions"
          },
          "docs": "Retrieves the current version"
        }
      ]
    }
  ],
  "bundled": true
}