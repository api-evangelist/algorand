          "name": "Export the master derivation key from a wallet",
          "request": {
            "name": "Export the master derivation key from a wallet",
            "description": {
              "content": "Export the master derivation key from the wallet. This key is a master \"backup\" key for the underlying wallet. With it, you can regenerate all of the wallets that have been generated with this wallet's `POST /v1/key` endpoint. This key will not allow you to recover keys imported from other wallets, however.\n",
              "type": "text/plain"
            },
