{
  "opencollection": "1.0.0",
  "info": {
    "name": "Algod REST API. common Transaction API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Algo-API-Token",
      "value": "{{X-Algo-API-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Transaction",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Sign a transaction",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost/v1/transaction/sign"
          },
          "docs": "Signs the passed transaction with a key from the wallet, determined by the sender encoded in the transaction.\n"
        }
      ]
    }
  ],
  "bundled": true
}