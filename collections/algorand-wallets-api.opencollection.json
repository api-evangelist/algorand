{
  "opencollection": "1.0.0",
  "info": {
    "name": "Algod REST API. common Wallets API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Algo-API-Token",
      "value": "{{X-Algo-API-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Wallets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List wallets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost/v1/wallets"
          },
          "docs": "Lists all of the wallets that kmd is aware of."
        }
      ]
    }
  ],
  "bundled": true
}